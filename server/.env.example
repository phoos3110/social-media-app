# Copy to server/.env. Without DATABASE_URL, local embedded PostgreSQL is used.
PORT=4180
CLIENT_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
NODE_ENV=development
# Docker overrides HOST=0.0.0.0, DATABASE_URL host=postgres and TRUST_PROXY_HOPS=1.
# Local Docker uses HTTP with COOKIE_SECURE=false. Use true behind HTTPS.
# DATABASE_URL=postgresql://social:social_local_password@localhost:5432/social
# DATABASE_SSL=true
# MEDIA_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional account email delivery (Resend + verified sending domain).
# APP_URL=https://po-social.onrender.com
# RESEND_API_KEY=
# EMAIL_FROM=Po <noreply@your-domain.example>
# Comma-separated login emails. No account is made admin automatically.
# ADMIN_EMAILS=
# For bootstrapping without email, explicitly allow an existing account UUID.
# ADMIN_USER_IDS=
# Run npm run push:keys --prefix server, then copy values to Render.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-email@example.com
